{
  "manifest_version": 3,
  "name": "Realtime Vietnamese Subtitles (JA->VI)",
  "version": "0.2.0",
  "description": "Dịch phụ đề tiếng Việt realtime cho mọi trang web video (xử lý bởi server local).",
  "host_permissions": [
    "http://127.0.0.1:8765/*",
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["page_hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
